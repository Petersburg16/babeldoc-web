# BabelDOC Web 运行配置（systemd EnvironmentFile：/opt/babeldoc-web/shared/env）
# 改完执行 systemctl restart babeldoc-web

# mock = 开发用假引擎；babeldoc = 真实翻译
BDW_ENGINE=babeldoc
BDW_DATA_DIR=/var/lib/babeldoc-web

# 通过 Cloudflare 子域名（HTTPS）对外访问后改为 true
BDW_COOKIE_SECURE=false

# 统计与额度按东八区计算“今天/本月”
BDW_TZ_OFFSET_HOURS=8

# 登录有效期（天）
BDW_SESSION_DAYS=30
