{
  "$comment": "PDF 工具运行时由本站分发的文件清单。改动后在 backend 目录运行 uv run python -m app.cli pdf-assets lock 重新生成 pdf-assets.lock.json。npm 来源取 package-lock.json 里锁定的版本；url 来源必须是固定版本的地址。lazy 表示由库按需自己去取、不预先下载。",
  "engines": {
    "render": {
      "label": "PDF 渲染数据",
      "lazy": true,
      "files": [
        {
          "path": "cmaps/",
          "npm": "pdfjs-dist",
          "dir": "cmaps"
        },
        {
          "path": "standard_fonts/",
          "npm": "pdfjs-dist",
          "dir": "standard_fonts",
          "include": [
            ".pfb",
            ".ttf"
          ]
        },
        {
          "path": "wasm/",
          "npm": "pdfjs-dist",
          "dir": "wasm",
          "include": [
            "openjpeg.wasm",
            "openjpeg_nowasm_fallback.js",
            "jbig2.wasm",
            "jbig2_nowasm_fallback.js",
            "qcms_bg.wasm"
          ]
        },
        {
          "path": "iccs/CGATS001Compat-v2-micro.icc",
          "npm": "pdfjs-dist",
          "file": "iccs/CGATS001Compat-v2-micro.icc"
        }
      ]
    },
    "qpdf": {
      "label": "qpdf 页面与加密引擎",
      "files": [
        {
          "path": "qpdf.wasm",
          "npm": "@neslinesli93/qpdf-wasm",
          "file": "dist/qpdf.wasm"
        }
      ]
    },
    "ocr": {
      "label": "OCR 识别引擎与中英文语言包",
      "files": [
        {
          "path": "worker.min.js",
          "npm": "tesseract.js",
          "file": "dist/worker.min.js"
        },
        {
          "path": "core/tesseract-core-relaxedsimd-lstm.wasm.js",
          "npm": "tesseract.js-core",
          "file": "tesseract-core-relaxedsimd-lstm.wasm.js",
          "lazy": true
        },
        {
          "path": "core/tesseract-core-simd-lstm.wasm.js",
          "npm": "tesseract.js-core",
          "file": "tesseract-core-simd-lstm.wasm.js",
          "lazy": true
        },
        {
          "path": "core/tesseract-core-lstm.wasm.js",
          "npm": "tesseract.js-core",
          "file": "tesseract-core-lstm.wasm.js",
          "lazy": true
        },
        {
          "path": "lang/eng.traineddata.gz",
          "npm": "@tesseract.js-data/eng",
          "file": "4.0.0_best_int/eng.traineddata.gz"
        },
        {
          "path": "lang/chi_sim.traineddata.gz",
          "npm": "@tesseract.js-data/chi_sim",
          "file": "4.0.0_best_int/chi_sim.traineddata.gz"
        }
      ]
    },
